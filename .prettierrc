{
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-native$",
    "",
    "^expo(.*)$",
    "",
    "^[a-zA-Z]",
    "",
    "^@(?!/).*",
    "",
    "^@/lib/(.*)$",
    "^@/constants/(.*)$",
    "^@/stores/(.*)$",
    "^@/utils/(.*)$",
    "",
    "^@/components/(.*)$",
    "^@/hooks/(.*)$",
    "^@/icons/(.*)$",
    "^@/data/(.*)$",
    "^@/assets/(.*)$",
    "",
    "^@/pages/(.*)$",
    "^@/routes/(.*)$",
    "",
    "^@/services/(.*)$",
    "^@/actions/(.*)$",
    "^@/api/(.*)$",
    "",
    "^@/(?!types/).*",
    "",
    "^[./]",
    "",
    "^@/types/(.*)$",
    ".*\\.(types|d\\.ts)$",
    "",
    ".*\\.css$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderParserPlugins": ["typescript", "jsx"]
}
